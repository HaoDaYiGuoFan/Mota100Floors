<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======== 地形 ======== -->
    <ImageBrush x:Key="TileFloorBrush" ImageSource="/Assets/Tiles/floor.png" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" />
    <ImageBrush x:Key="TileWallBrush" ImageSource="/Assets/Tiles/wall.png" Stretch="Fill" />
    <ImageBrush x:Key="TileStairUpBrush" ImageSource="/Assets/Tiles/stairup.png" Stretch="Fill" />
    <ImageBrush x:Key="TileStairDownBrush" ImageSource="/Assets/Tiles/stairdown.png" Stretch="Fill" />

    <!-- ======== 门 ======== -->
    <ImageBrush x:Key="DoorRedBrush" ImageSource="/Assets/Tiles/door_red.png" Stretch="Fill" />
    <ImageBrush x:Key="DoorBlueBrush" ImageSource="/Assets/Tiles/door_blue.png" Stretch="Fill" />
    <ImageBrush x:Key="DoorYellowBrush" ImageSource="/Assets/Tiles/door_yellow.png" Stretch="Fill" />

    <!-- ======== 怪物（经典换皮：1~6 号贴图，按 SpriteIndex 选取） ======== -->
    <ImageBrush x:Key="MonsterClassic1Brush" ImageSource="/Assets/Tiles/monster_classic_1.png" Stretch="Fill" />
    <ImageBrush x:Key="MonsterClassic2Brush" ImageSource="/Assets/Tiles/monster_classic_2.png" Stretch="Fill" />
    <ImageBrush x:Key="MonsterClassic3Brush" ImageSource="/Assets/Tiles/monster_classic_3.png" Stretch="Fill" />
    <ImageBrush x:Key="MonsterClassic4Brush" ImageSource="/Assets/Tiles/monster_classic_4.png" Stretch="Fill" />
    <ImageBrush x:Key="MonsterClassic5Brush" ImageSource="/Assets/Tiles/monster_classic_5.png" Stretch="Fill" />
    <ImageBrush x:Key="MonsterClassic6Brush" ImageSource="/Assets/Tiles/monster_classic_6.png" Stretch="Fill" />

    <!-- ======== 道具 ======== -->
    <ImageBrush x:Key="ItemHpBrush" ImageSource="/Assets/Tiles/item_hp.png" Stretch="Fill" />
    <ImageBrush x:Key="ItemAttackBrush" ImageSource="/Assets/Tiles/item_attack.png" Stretch="Fill" />
    <ImageBrush x:Key="ItemDefenseBrush" ImageSource="/Assets/Tiles/item_defense.png" Stretch="Fill" />
    <ImageBrush x:Key="ItemKeyRedBrush" ImageSource="/Assets/Tiles/key_red.png" Stretch="Fill" />
    <ImageBrush x:Key="ItemKeyBlueBrush" ImageSource="/Assets/Tiles/key_blue.png" Stretch="Fill" />
    <ImageBrush x:Key="ItemKeyYellowBrush" ImageSource="/Assets/Tiles/key_yellow.png" Stretch="Fill" />
    <ImageBrush x:Key="ItemFlyOrbBrush" ImageSource="/Assets/Tiles/item_flyorb.png" Stretch="Fill" />

    <!-- ======== 玩家（四方向） / NPC / 商店 ======== -->
    <ImageBrush x:Key="PlayerUpBrush" ImageSource="/Assets/Tiles/player_up.png" Stretch="Fill" />
    <ImageBrush x:Key="PlayerDownBrush" ImageSource="/Assets/Tiles/player_down.png" Stretch="Fill" />
    <ImageBrush x:Key="PlayerLeftBrush" ImageSource="/Assets/Tiles/player_left.png" Stretch="Fill" />
    <ImageBrush x:Key="PlayerRightBrush" ImageSource="/Assets/Tiles/player_right.png" Stretch="Fill" />
    <ImageBrush x:Key="NpcBrush" ImageSource="/Assets/Tiles/npc.png" Stretch="Fill" />
    <ImageBrush x:Key="ShopBrush" ImageSource="/Assets/Tiles/shop.png" Stretch="Fill" />
    <ImageBrush x:Key="StarBrush" ImageSource="/Assets/Tiles/star.png" Stretch="Fill" />

    <!-- ======== UI 通用（明亮暖色主题） ======== -->
    <!-- 窗口底色：暖阳般的渐变，让开局即明亮 -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDF5E3" Offset="0" />
        <GradientStop Color="#FFF8E3BE" Offset="0.55" />
        <GradientStop Color="#FFF2D19C" Offset="1" />
    </LinearGradientBrush>

    <!-- 顶部 HUD 栏：鲜亮的奶油金渐变 -->
    <LinearGradientBrush x:Key="HudBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFDF8" Offset="0" />
        <GradientStop Color="#FFFFF3D6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HudBorderBrush" Color="#FFE8C088" />

    <!-- 标题 / 强调色 -->
    <SolidColorBrush x:Key="TitleBrush" Color="#FFD98300" />
    <SolidColorBrush x:Key="HudTextBrush" Color="#FF6B4A1B" />
    <SolidColorBrush x:Key="HudValueTextBrush" Color="#FFD43B3B" />
    <SolidColorBrush x:Key="HudSectionBrush" Color="#FF9A6B1F" />

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFDF8EE" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFC89B5C" />
    <SolidColorBrush x:Key="PanelTextBrush" Color="#FF3B3B3B" />
    <SolidColorBrush x:Key="HintTextBrush" Color="#FF5A5A5A" />

    <!-- ======== 按钮（金色明亮风格，全局生效） ======== -->
    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFBE08C" Offset="0" />
        <GradientStop Color="#FFF0A848" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFEEBB4" Offset="0" />
        <GradientStop Color="#FFF7BE64" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE8A02C" Offset="0" />
        <GradientStop Color="#FFD98A1E" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
        <Setter Property="Foreground" Value="#FF6B3A00" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#FFEAC189"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
