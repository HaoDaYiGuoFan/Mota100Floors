<Window x:Class="Mota100Floors.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:Mota100Floors.Helpers.Enum"
        Title="魔塔 100 层"
        Icon="/Assets/icon.ico"
        Width="1280"
        Height="840"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="HudGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource HudTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource HudValueTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,16,0" />
        </Style>
        <Style x:Key="PanelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======== 顶部 HUD ======== -->
        <Border Grid.Row="0"
                Background="{StaticResource HudBackgroundBrush}"
                BorderBrush="{StaticResource HudBorderBrush}"
                BorderThickness="0,0,0,3"
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="魔塔 100 层"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TitleBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,28,0" />
                    <Image Source="/Assets/Tiles/icon_hp.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="生命：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudHp" Text="0" Style="{StaticResource HudValue}" />
                    <Image Source="/Assets/Tiles/icon_atk.png" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <TextBlock Text="攻击：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudAttack" Text="0" Style="{StaticResource HudValue}" />
                    <Image Source="/Assets/Tiles/icon_def.png" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <TextBlock Text="防御：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudDefense" Text="0" Style="{StaticResource HudValue}" />
                    <Image Source="/Assets/Tiles/icon_gold.png" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <TextBlock Text="金币：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudGold" Text="0" Style="{StaticResource HudValue}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Image Source="/Assets/Tiles/icon_key_red.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="红钥：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudRedKey" Text="0" Style="{StaticResource HudValue}" />
                    <Image Source="/Assets/Tiles/icon_key_blue.png" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <TextBlock Text="蓝钥：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudBlueKey" Text="0" Style="{StaticResource HudValue}" />
                    <Image Source="/Assets/Tiles/icon_key_yellow.png" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <TextBlock Text="黄钥：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudYellowKey" Text="0" Style="{StaticResource HudValue}" />
                    <Image Source="/Assets/Tiles/icon_floor.png" Width="24" Height="24" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <TextBlock Text="层数：" Style="{StaticResource HudGroup}" />
                    <TextBlock x:Name="HudFloor" Text="1/100" Style="{StaticResource HudValue}" />
                    <Button Content="重新开始"
                            Click="OnRestartClick"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Padding="14,6"
                            FontSize="16" />
                    <Button Content="存档 F5"
                            Click="OnSaveClick"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Padding="14,6"
                            FontSize="16" />
                    <Button Content="读档 F9"
                            Click="OnLoadClick"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Padding="14,6"
                            FontSize="16" />
                    <Button Content="怪物手册 B"
                            Click="OnBestiaryClick"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Padding="14,6"
                            FontSize="16" />
                    <Button Content="背包 I"
                            Click="OnInventoryClick"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Padding="14,6"
                            FontSize="16" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======== 主区域 ======== -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 地图 -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    Background="{StaticResource TileFloorBrush}">
                <Canvas x:Name="MapCanvas"
                        Width="864"
                        Height="528"
                        ClipToBounds="True"
                        RenderOptions.EdgeMode="Aliased"
                        RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <!-- 右侧面板 -->
            <DockPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="事件记录"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource HudSectionBrush}"
                           Margin="0,0,0,6" />
                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="8,6"
                        Margin="0,10,0,0">
                    <TextBlock Text="操作：方向键 / WASD 移动，踩敌人自动战斗，B 查看怪物手册，F5 存档，F9 读档，Esc 关闭面板，M 静音/音乐"
                               FontSize="14"
                               Foreground="{StaticResource HintTextBrush}" />
                </Border>
                <Border Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1">
                    <ScrollViewer x:Name="MsgScroller"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MessageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource PanelText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>

        <!-- ======== 商店弹窗 ======== -->
        <Grid x:Name="ShopOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="#AA000000">
            <Border Width="440"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ShopTitle"
                               Text="商店"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource PanelBorderBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                        <Image Source="/Assets/Tiles/icon_gold.png" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="ShopGold"
                                   Text="当前金币：0"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#FF8B0000" />
                    </StackPanel>
                    <ItemsControl x:Name="ShopList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}"
                                        Click="OnShopBuyClick"
                                        Margin="0,3"
                                        Padding="10,6"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="/Assets/Tiles/item_hp.png" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static h:ItemType.Attack}">
                                                            <Setter Property="Source" Value="/Assets/Tiles/item_attack.png" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static h:ItemType.Defense}">
                                                            <Setter Property="Source" Value="/Assets/Tiles/item_defense.png" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Type}" Value="{x:Static h:ItemType.Key}" />
                                                                <Condition Binding="{Binding KeyType}" Value="{x:Static h:KeyType.Red}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Source" Value="/Assets/Tiles/key_red.png" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Type}" Value="{x:Static h:ItemType.Key}" />
                                                                <Condition Binding="{Binding KeyType}" Value="{x:Static h:KeyType.Blue}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Source" Value="/Assets/Tiles/key_blue.png" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Type}" Value="{x:Static h:ItemType.Key}" />
                                                                <Condition Binding="{Binding KeyType}" Value="{x:Static h:KeyType.Yellow}" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Source" Value="/Assets/Tiles/key_yellow.png" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding Price, StringFormat=' —— {0} 金币'}"
                                                   FontSize="17"
                                                   Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="离开商店（Esc）"
                            Click="OnShopCloseClick"
                            Margin="0,14,0,0"
                            Padding="12,8"
                            FontSize="15"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
        <!-- ======== 背包弹窗（I 键开关，黑底白字复古风格） ======== -->
        <Grid x:Name="InventoryOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="#D0000000">
            <Border Width="470"
                    Background="#FF1A1712"
                    BorderBrush="#FFE8C088"
                    BorderThickness="2"
                    CornerRadius="4"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="InventoryTitle"
                               Text="背 包"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFFFE9A8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14" />
                    <!-- 飞行器（楼层穿梭机）持有区 -->
                    <StackPanel x:Name="InventoryFlyOrbSection" Visibility="Collapsed">
                        <Border Background="#FF2A241B"
                                BorderBrush="#FFE8C088"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/Tiles/icon_flyorb.png"
                                       Width="32"
                                       Height="32"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="飞行器（楼层穿梭机）"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#FFFFF3D6" />
                                    <TextBlock Text="永久持有 · 无使用次数 · 在楼梯旁使用"
                                               FontSize="13"
                                               Foreground="#FFCFB98C"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="使用"
                                        Click="OnFlyOrbUseClick"
                                        VerticalAlignment="Center"
                                        Padding="18,7"
                                        FontSize="15" />
                            </Grid>
                        </Border>
                        <TextBlock Text="使用飞行器需要站在楼梯（上楼 / 下楼楼梯）格子上，且只能传送到已经探索过的楼层。"
                                   FontSize="13"
                                   Foreground="#FF9A9A9A"
                                   TextWrapping="Wrap"
                                   Margin="4,10,4,0" />
                    </StackPanel>
                    <TextBlock x:Name="InventoryEmptyText"
                               Text="背包空空如也。"
                               FontSize="16"
                               Foreground="#FF9A9A9A"
                               HorizontalAlignment="Center"
                               Margin="0,16" />
                    <Button Content="关闭（Esc）"
                            Click="OnInventoryCloseClick"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Padding="34,8"
                            FontSize="15" />
                </StackPanel>
            </Border>
        </Grid>


        <!-- ======== 楼层穿梭飞行器面板（打开条件：持有飞行器 + 站在楼梯格） ======== -->
        <Grid x:Name="FlyOrbOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="#D0000000">
            <Border Width="480"
                    MaxHeight="640"
                    Background="#FF1A1712"
                    BorderBrush="#FFE8C088"
                    BorderThickness="2"
                    CornerRadius="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Margin="20">
                    <TextBlock Text="【楼层穿梭飞行器】"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#FFFFE9A8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />
                    <TextBlock Text="只能传送到已经到达过的楼层 · 未探索楼层置灰不可选"
                               FontSize="13"
                               Foreground="#FFCFB98C"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                    <ScrollViewer MaxHeight="400"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FlyOrbFloorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding FloorNumber}"
                                            Click="OnFlyOrbFloorClick"
                                            IsEnabled="{Binding IsVisited}"
                                            Margin="0,2"
                                            Padding="10,5"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="{Binding HintText}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#FF2A241B" />
                                                <Setter Property="Foreground" Value="#FFFFF3D6" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="RowBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="#FF4A3F2A"
                                                                    BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Left"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="RowBorder"
                                                                            Property="Background"
                                                                            Value="#FF3A2F1A" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="RowBorder"
                                                                            Property="Opacity"
                                                                            Value="0.38" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FloorLabel}"
                                                       FontSize="15"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="{Binding StateText}"
                                                       FontSize="12"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding StateBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,14,0,0">
                        <Button x:Name="FlyOrbTeleportBtn"
                                Content="传 送"
                                Click="OnFlyOrbTeleportClick"
                                Padding="30,8"
                                FontSize="16" />
                        <Button Content="取 消"
                                Click="OnFlyOrbCancelClick"
                                Padding="30,8"
                                FontSize="16"
                                Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>


<!-- ======== 怪物手册弹窗（B 键开关） ======== -->
        <Grid x:Name="BestiaryOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="#AA000000">
            <Border Width="880"
                    MaxHeight="736"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="怪物手册（按 B 或点击「关闭」退出）"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PanelBorderBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2" />
                    <TextBlock DockPanel.Dock="Top"
                               FontSize="13"
                               Foreground="{StaticResource HintTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8">
                        <Run Text="预估损失 = 回合数 × 每回合伤害（与真实战斗一致）｜法师系怪物" />
                        <Run Text="无视防御" FontWeight="Bold" Foreground="#FFB85A00" />
                        <Run Text="（伤害 = 攻击力）" />
                    </TextBlock>
                    <Button DockPanel.Dock="Bottom"
                            Content="关闭"
                            Click="OnBestiaryCloseClick"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Padding="18,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BestiaryList">
<ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFEAD9B6"
                                            BorderThickness="0,0,0,1"
                                            Padding="6,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="176" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding SpritePath}"
                                                   Width="44"
                                                   Height="44"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                   VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PanelTextBrush}" />
                                                    <TextBlock Text="{Binding KindText}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#FFB85A00"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock FontSize="13"
                                                           Foreground="{StaticResource HudTextBrush}"
                                                           Margin="0,3,0,0">
                                                    <Run Text="生命 " />
                                                    <Run Text="{Binding Hp}" />
                                                    <Run Text="  攻击 " />
                                                    <Run Text="{Binding Attack}" />
                                                    <Run Text="  防御 " />
                                                    <Run Text="{Binding Defense}" />
                                                    <Run Text="  金币 " />
                                                    <Run Text="{Binding Gold}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DamageText}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#FFD43B3B" />
                                                <TextBlock Text="{Binding CanKillText}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding CanKillBrush}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======== 战斗弹窗（逐回合，GDD V1.0 §3.2） ======== -->
        <Grid x:Name="BattleOverlay"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="#C8000000">
            <Border Width="720"
                    MaxHeight="700"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BattleIntro"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource PanelBorderBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                Padding="10"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <Image x:Name="BattleSprite"
                                       Width="84"
                                       Height="84"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center" />
                                <TextBlock x:Name="BattleMonsterName"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"
                                           Foreground="#FFC63B3B" />
                                <TextBlock x:Name="BattleKindText"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#FFB85A00"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                                <TextBlock x:Name="BattleMonsterStats"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                                <TextBlock x:Name="BattleMonsterHp"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FFC63B3B"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⚔"
                                       FontSize="42"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="逐回合战斗"
                                       FontSize="12"
                                       Foreground="{StaticResource HintTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="2"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                Padding="10"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <Image Source="/Assets/Tiles/player_down.png"
                                       Width="72"
                                       Height="72"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center" />
                                <TextBlock Text="勇士"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                                <TextBlock x:Name="BattlePlayerHp"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FF2E7D32"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                                <TextBlock x:Name="BattlePlayerAttack"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />
                                <TextBlock x:Name="BattlePlayerDefense"
                                           FontSize="12"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,10,0,0"
                            MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="BattleLog"
                                       FontSize="13"
                                       FontFamily="Consolas"
                                       LineHeight="1.35"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <!-- 原版魔塔：触怪即战，无确认/撤退；战斗结束自动结算 -->
                    <StackPanel x:Name="BattleResultPanel"
                                Visibility="Collapsed"
                                Margin="0,16,0,0">
                        <TextBlock x:Name="BattleResultTitle"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="BattleResultDetail"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

